FROM maven:3.8.6-openjdk-8-slim

WORKDIR /app

# Copy pom.xml
COPY pom.xml .

# Create directory structure
RUN mkdir -p src/main/java/com/sallm/Tainted/Author src/test/java/com/sallm/Tainted/Author

# Copy source and test files
COPY A_cwe776_0.java src/main/java/com/sallm/Tainted/Author/
COPY TestA_cwe776_0.java src/test/java/com/sallm/Tainted/Author/

# Option to inject solution at build time
ARG SCRIPT_CONTENT
RUN if [ ! -z "$SCRIPT_CONTENT" ]; then echo "$SCRIPT_CONTENT" | base64 -d > src/main/java/com/sallm/Tainted/Author/A_cwe776_0.java; fi

# Default command to run tests
CMD ["mvn", "test"]
