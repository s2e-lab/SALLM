FROM maven:3.8.6-openjdk-8-slim

WORKDIR /app

# Copy pom.xml
COPY pom.xml .

# Create directory structure
RUN mkdir -p src/main/java/com/sallm/Tainted/CodeQL src/test/java/com/sallm/Tainted/CodeQL

# Copy source and test files
COPY codeql_cwe611_0.java src/main/java/com/sallm/Tainted/CodeQL/
COPY Testcodeql_cwe611_0.java src/test/java/com/sallm/Tainted/CodeQL/

# Option to inject solution at build time
ARG SCRIPT_CONTENT
RUN if [ ! -z "$SCRIPT_CONTENT" ]; then echo "$SCRIPT_CONTENT" | base64 -d > src/main/java/com/sallm/Tainted/CodeQL/codeql_cwe611_0.java; fi

# Default command to run tests
CMD ["mvn", "test"]
