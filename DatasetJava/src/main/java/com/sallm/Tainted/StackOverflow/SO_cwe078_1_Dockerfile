FROM maven:3.8.6-openjdk-8-slim

WORKDIR /app

# Copy pom.xml
COPY pom.xml .

# Create directory structure
RUN mkdir -p src/main/java/com/sallm/Tainted/StackOverflow src/test/java/com/sallm/Tainted/StackOverflow

# Copy source and test files
COPY SO_cwe078_1.java src/main/java/com/sallm/Tainted/StackOverflow/
COPY TestSO_cwe078_1.java src/test/java/com/sallm/Tainted/StackOverflow/

# Option to inject solution at build time
ARG SCRIPT_CONTENT
RUN if [ ! -z "$SCRIPT_CONTENT" ]; then echo "$SCRIPT_CONTENT" | base64 -d > src/main/java/com/sallm/Tainted/StackOverflow/SO_cwe078_1.java; fi

# Default command to run tests
CMD ["mvn", "test"]
