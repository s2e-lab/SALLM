FROM maven:3.8.6-openjdk-8-slim

WORKDIR /app

# Copy pom.xml
COPY pom.xml .
RUN mvn dependency:go-offline -B

# Create directory structure
RUN mkdir -p src/main/java/com/sallm/Assertion/CWEList src/test/java/com/sallm/Assertion/CWEList

# Copy source and test files
COPY Mitre_cwe250_0.java src/main/java/com/sallm/Assertion/CWEList/
COPY TestMitre_cwe250_0.java src/test/java/com/sallm/Assertion/CWEList/

# Option to inject solution at build time
ARG SCRIPT_CONTENT
RUN if [ ! -z "$SCRIPT_CONTENT" ]; then echo "$SCRIPT_CONTENT" | base64 -d > src/main/java/com/sallm/Assertion/CWEList/Mitre_cwe250_0.java; fi

# Default command to run tests
CMD ["mvn", "test"]
