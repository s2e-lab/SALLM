FROM maven:3.8.6-openjdk-8-slim

WORKDIR /app

# Copy pom.xml
COPY pom.xml .
RUN mvn dependency:go-offline -B

# Create directory structure
RUN mkdir -p src/main/java/com/sallm/Assertion/SonarSource src/test/java/com/sallm/Assertion/SonarSource

# Copy source and test files
COPY SS_cwe099_0.java src/main/java/com/sallm/Assertion/SonarSource/
COPY TestSS_cwe099_0.java src/test/java/com/sallm/Assertion/SonarSource/

# Option to inject solution at build time
ARG SCRIPT_CONTENT
RUN if [ ! -z "$SCRIPT_CONTENT" ]; then echo "$SCRIPT_CONTENT" | base64 -d > src/main/java/com/sallm/Assertion/SonarSource/SS_cwe099_0.java; fi

# Default command to run tests
CMD ["mvn", "test"]
