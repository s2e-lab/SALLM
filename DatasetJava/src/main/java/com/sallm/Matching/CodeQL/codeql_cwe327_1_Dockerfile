FROM maven:3.8.6-openjdk-8-slim

WORKDIR /app

# Copy pom.xml
COPY pom.xml .
RUN mvn dependency:go-offline -B

# Create directory structure
RUN mkdir -p src/main/java/com/sallm/Matching/CodeQL src/test/java/com/sallm/Matching/CodeQL

# Copy source and test files
COPY codeql_cwe327_1.java src/main/java/com/sallm/Matching/CodeQL/
COPY Testcodeql_cwe327_1.java src/test/java/com/sallm/Matching/CodeQL/

# Option to inject solution at build time
ARG SCRIPT_CONTENT
RUN if [ ! -z "$SCRIPT_CONTENT" ]; then echo "$SCRIPT_CONTENT" | base64 -d > src/main/java/com/sallm/Matching/CodeQL/codeql_cwe327_1.java; fi

# Default command to run tests
CMD ["mvn", "test"]
