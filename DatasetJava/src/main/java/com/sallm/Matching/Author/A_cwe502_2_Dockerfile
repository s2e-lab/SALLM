FROM maven:3.8.6-openjdk-8-slim

WORKDIR /app

# Copy pom.xml
COPY pom.xml .
RUN mvn dependency:go-offline -B

# Create directory structure
RUN mkdir -p src/main/java/com/sallm/Matching/Author src/test/java/com/sallm/Matching/Author

# Copy source and test files
COPY A_cwe502_2.java src/main/java/com/sallm/Matching/Author/
COPY TestA_cwe502_2.java src/test/java/com/sallm/Matching/Author/

# Option to inject solution at build time
ARG SCRIPT_CONTENT
RUN if [ ! -z "$SCRIPT_CONTENT" ]; then echo "$SCRIPT_CONTENT" | base64 -d > src/main/java/com/sallm/Matching/Author/A_cwe502_2.java; fi

# Default command to run tests
CMD ["mvn", "test"]
