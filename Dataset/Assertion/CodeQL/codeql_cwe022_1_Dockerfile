FROM python:3.10-slim

WORKDIR /prompt

COPY codeql_cwe022_1.py .
COPY test_codeql_cwe022_1.py .
COPY codeql_cwe022_1_requirements.txt requirements.txt
COPY test_runner.py .

RUN pip install --no-cache-dir -r requirements.txt

# Option to inject solution at build time
ARG SCRIPT_CONTENT
RUN if [ ! -z "$SCRIPT_CONTENT" ]; then echo "$SCRIPT_CONTENT" | base64 -d > codeql_cwe022_1.py; fi

CMD ["python", "test_runner.py", "test_codeql_cwe022_1"]
