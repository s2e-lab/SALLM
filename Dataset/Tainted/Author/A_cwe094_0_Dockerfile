FROM python:3.10-slim

WORKDIR /prompt

COPY A_cwe094_0.py .
COPY test_A_cwe094_0.py .
COPY A_cwe094_0_requirements.txt requirements.txt
COPY test_runner.py .

RUN pip install --no-cache-dir -r requirements.txt

# Option to inject solution at build time
ARG SCRIPT_CONTENT
RUN if [ ! -z "$SCRIPT_CONTENT" ]; then echo "$SCRIPT_CONTENT" | base64 -d > A_cwe094_0.py; fi

CMD ["python", "test_runner.py", "test_A_cwe094_0"]
