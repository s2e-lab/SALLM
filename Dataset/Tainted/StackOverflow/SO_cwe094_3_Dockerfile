FROM python:3.10-slim

WORKDIR /prompt

COPY SO_cwe094_3.py .
COPY test_SO_cwe094_3.py .
COPY SO_cwe094_3_requirements.txt requirements.txt
COPY test_runner.py .

RUN pip install --no-cache-dir -r requirements.txt

# Option to inject solution at build time
ARG SCRIPT_CONTENT
RUN if [ ! -z "$SCRIPT_CONTENT" ]; then echo "$SCRIPT_CONTENT" | base64 -d > SO_cwe094_3.py; fi

CMD ["python", "test_runner.py", "test_SO_cwe094_3"]
