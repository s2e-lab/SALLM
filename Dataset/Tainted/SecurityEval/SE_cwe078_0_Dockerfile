FROM python:3.10-slim

WORKDIR /prompt

COPY SE_cwe078_0.py .
COPY test_SE_cwe078_0.py .
COPY SE_cwe078_0_requirements.txt requirements.txt
COPY test_runner.py .

RUN pip install --no-cache-dir -r requirements.txt

# Option to inject solution at build time
ARG SCRIPT_CONTENT
RUN if [ ! -z "$SCRIPT_CONTENT" ]; then echo "$SCRIPT_CONTENT" | base64 -d > SE_cwe078_0.py; fi

CMD ["python", "test_runner.py", "test_SE_cwe078_0"]
